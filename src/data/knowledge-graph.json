    {
      "id": "赤楊",
      "node_Group": "物件",
      "meta_group": "物質文化",
      "info": "赤楊（Alnus formosana）是台灣原生速生闊葉樹種，高可達20-30公尺，常見於河岸濕地、低海拔溪谷及次生林，具固氮能力。在南澳鄉廣泛分布，尤其溪畔及山坡濕潤地帶，與楓香、杜英形成混交林，是當地林下經濟重要樹種。",
      "start_year": null,
      "end_year": null,
      "lon": null,
      "lat": null,
      "breakthrough_note": "",
      "sources": [
        "竺庭"
      ]
