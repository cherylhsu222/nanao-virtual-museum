# Existing memory-map Supabase project
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# New projects can use the public publishable key instead of the legacy anon key.
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_STORAGE_BUCKET=memory-images
VITE_MEMORY_SUBMISSIONS_TABLE=museum_memory_submissions

# Optional adapter used when the hosted project exposes a submission route.
# VITE_MEMORY_SUBMISSION_ENDPOINT=
